# ==============================================================================
# Shared Environment Variable Template (`.env.example`)
# Copy to `.env` locally. NEVER commit `.env` or post secret values on the board.
# ==============================================================================

# --- 1. Supabase Postgres (Backend `zekihxh` only; isolated in `rover_backend`) ---
# Existing `public` schema belongs to adaptive-python-mentor and MUST NOT be used.
# `rover_backend` is revoked from `PUBLIC, anon, authenticated` and is accessed
# strictly by `backend/` via direct Postgres connections scoped to `rover_backend`.
SUPABASE_PROJECT_ID=buojgmoumyzqxmerckjm
SUPABASE_URL=https://buojgmoumyzqxmerckjm.supabase.co
SUPABASE_DB_SCHEMA=rover_backend
# Canonical P3 (`zekihxh`) Postgres connection strings (scoped to `rover_backend`):
# - `BACKEND_MIGRATION_DATABASE_URL`: migration role (`rover_backend_migrator`)
# - `BACKEND_DATABASE_URL`: narrower DML-only runtime role (`rover_backend_runtime`)
# - `BACKEND_TEST_DATABASE_URL`: isolated test database/schema connection string
BACKEND_MIGRATION_DATABASE_URL=
BACKEND_DATABASE_URL=
BACKEND_TEST_DATABASE_URL=
# Optional Supabase service-role key (server-side backend only; does NOT replace
# the narrower `BACKEND_DATABASE_URL` runtime login and never reaches browser or peers):
SUPABASE_SERVICE_ROLE_KEY=

# --- 2. Inter-Service & Operator Auth Tokens (>= 16 unpredictable chars) ---
# Vision API bearer token (used by consumers calling vision `/api/*` directly):
VISION_TOKEN=<generate-random-token-min-16-chars>
# Shared server-to-server bearer token (vision <-> mapping <-> backend <-> robot):
PEER_TOKEN=<generate-distinct-random-token-min-16-chars>
# Operator token exchanged at `POST /api/session` for an HttpOnly dashboard cookie:
OPERATOR_TOKEN=<generate-distinct-random-token-min-16-chars>
# Keep `Secure` enabled by default (`1`); set `BACKEND_COOKIE_SECURE=0` strictly
# for local `http://localhost` / `http://127.0.0.1` HTTP development:
BACKEND_COOKIE_SECURE=1

# --- 3. Vision Service (`vision/**` - `AlanDD13`) ---
VISION_CAMERAS=phone-1:FIXED,phone-2:FIXED,mac-1:FIXED,rover-1:ROVER
VISION_LOCAL_SOURCES={}
VISION_MODEL=vision/.local/yoloe-26s-seg-pf.pt
VISION_DEVICE=mps
# Opt-in targeted small-floor-object vocabulary; preserves person/animal/hand prompts.
VISION_DETECTOR_PROFILE=default
# VISION_IMAGE_SIZE=960  # optional override; paper profile defaults to 960
VISION_PAPER_TILES=1
# Optional JSON array; custom text classes require a prompted *-seg.pt checkpoint.
VISION_DETECTION_CLASSES=
# Advisory only, measured at the object's depth; blank means unknown size.
VISION_MM_PER_PX=
ROVER_CAMERA_ID=rover-1
CCTV_STREAM_URL=http://192.168.5.146:8081/video

# --- 4. Peer Service Base URLs ---
VISION_URL=http://127.0.0.1:8443
MAPPING_URL=http://127.0.0.1:8002
BACKEND_URL=http://127.0.0.1:8000
ROVER_BRIDGE_URL=http://127.0.0.1:8003
ROBOT_BRIDGE_URL=http://127.0.0.1:8004

# --- 5. LLM / Grok / OpenRouter (`vision/**` and `backend/**`) ---
XAI_API_KEY=
GROK_VISION_MODEL=grok-4.7
# xai or openrouter. OpenRouter transport still calls xAI's Grok, never a non-Grok fallback.
GROK_VISION_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=x-ai/grok-4.7
OPENROUTER_FAST_MODEL=x-ai/grok-4.1-fast
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_TIMEOUT_SECONDS=30
