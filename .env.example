# ==============================================================================
# Shared Environment Variable Template (`.env.example`)
# Copy to `.env` locally. NEVER commit `.env` or post secret values on the board.
# ==============================================================================

# --- 1. Supabase (Backend `zekihxh` only; isolated in `rover_backend` schema) ---
# Existing `public` schema belongs to adaptive-python-mentor and MUST NOT be used.
SUPABASE_PROJECT_ID=buojgmoumyzqxmerckjm
SUPABASE_URL=https://buojgmoumyzqxmerckjm.supabase.co
SUPABASE_DB_SCHEMA=rover_backend
SUPABASE_KEY=<anon-or-publishable-key>
SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Backend server-side only (never expose to browser/frontend or commit to Git):
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
# Optional direct Postgres migration URL for backend schema owner (`zekihxh`):
DATABASE_URL=

# --- 2. Inter-Service & Operator Auth Tokens (>= 16 unpredictable chars) ---
# Vision API bearer token (used by consumers calling vision `/api/*` directly):
VISION_TOKEN=<generate-random-token-min-16-chars>
# Shared server-to-server bearer token (vision <-> mapping <-> backend <-> robot):
PEER_TOKEN=<generate-distinct-random-token-min-16-chars>
# Operator token exchanged at `POST /api/session` for an HttpOnly dashboard cookie:
OPERATOR_TOKEN=<generate-distinct-random-token-min-16-chars>

# --- 3. Vision Service (`vision/**` - `AlanDD13`) ---
VISION_CAMERAS=phone-1:FIXED,phone-2:FIXED,mac-1:FIXED,rover-1:ROVER
VISION_LOCAL_SOURCES={}
VISION_MODEL=vision/.local/yoloe-26s-seg-pf.pt
VISION_DEVICE=mps
ROVER_CAMERA_ID=rover-1
CCTV_STREAM_URL=http://192.168.5.146:8081/video

# --- 4. Peer Service Base URLs ---
VISION_URL=http://127.0.0.1:8443
MAPPING_URL=http://127.0.0.1:8002
BACKEND_URL=http://127.0.0.1:8000
ROVER_BRIDGE_URL=http://127.0.0.1:8003

# --- 5. LLM / Grok / OpenRouter (`vision/**` and `backend/**`) ---
XAI_API_KEY=
GROK_VISION_MODEL=grok-4.7
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=x-ai/grok-4.1-fast
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_TIMEOUT_SECONDS=30
